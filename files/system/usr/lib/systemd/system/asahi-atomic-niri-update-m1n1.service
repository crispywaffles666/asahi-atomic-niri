[Unit]
Description=Refresh Asahi m1n1/U-Boot/DTBs for the booted Atomic deployment
Documentation=man:update-m1n1(8)
# Wait until this tree has booted, then update its stage-2 m1n1 payload. This
# service neither reboots nor applies another update.
After=multi-user.target
Wants=multi-user.target
DefaultDependencies=no
# The success mark lives in /var, which all OSTree trees share.
RequiresMountsFor=/var/lib/asahi-atomic-niri

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/asahi-atomic-niri/update-m1n1-helper.sh refresh

[Install]
WantedBy=multi-user.target
