[Unit]
Description=Refresh Asahi m1n1/U-Boot/DTBs for the booted Atomic deployment
Documentation=man:update-m1n1(8)
# Runs only after this Atomic deployment has booted far enough to reach
# multi-user.target, i.e. it has proven it can boot. It then refreshes the
# stage-2 m1n1 payload for this exact deployment (deployment-aware, idempotent,
# fail-closed). It never reboots or auto-applies anything itself.
After=multi-user.target
Wants=multi-user.target
DefaultDependencies=no
# The deployment-success marker lives under /var (shared + persistent across
# OSTree deployments), so ensure it is fully mounted and writable.
RequiresMountsFor=/var/lib/asahi-atomic-niri

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/asahi-atomic-niri/update-m1n1-helper.sh refresh

[Install]
WantedBy=multi-user.target
