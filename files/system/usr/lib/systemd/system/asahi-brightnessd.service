[Unit]
Description=Ambient-light auto-brightness (keyboard backlight)
Documentation=https://github.com/craig-miller/asahi-brightnessd
# This build changes only the keyboard light, which keeps Noctalia from showing
# an OSD for screen changes. Wait for udev to find the light and sensor. Skip
# hosts without the light; retry while the sensor data is not yet ready.
ConditionPathExists=/sys/class/leds/kbd_backlight/max_brightness
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/sbin/asahi-brightnessd
Restart=on-failure
RestartSec=5s
# Root must write the light in /sys. ProtectSystem=strict still allows API paths.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
