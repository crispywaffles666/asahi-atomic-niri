[Unit]
Description=Install image default user Flatpaks (Flatseal, Warehouse, Smile)
# User systemd has no network-online.target. A failed run leaves no mark, so the
# next login tries again.
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
Environment=HOME=%h
ExecStart=/usr/libexec/asahi-niri/config-flatpaks.sh

[Install]
WantedBy=default.target
