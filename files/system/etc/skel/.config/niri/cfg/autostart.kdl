// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-at-startup "noctalia"
    spawn-at-startup "sh" "-c" "$HOME/.local/bin/niri-overview-autoclose.sh"
    spawn-at-startup "sh" "-c" "$HOME/.local/bin/auto-fullwidth-dp3.sh"
    spawn-at-startup "sh" "-c" "$HOME/.local/bin/screenshot-notify.sh"
